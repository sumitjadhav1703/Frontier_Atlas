# =============================================================================
# signal-ingest · copy to .env and edit locally
#   cp .env.example .env
# Never commit .env. Never paste API keys into chat.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) MODE (required)
# -----------------------------------------------------------------------------
# fixture = offline gates B0–B7 (default). Live HTTP/providers stay off.
# live    = B8+ acquisition / LLM canary. Needs network + keys below.
SIGNAL_INGEST_MODE=fixture

# -----------------------------------------------------------------------------
# 2) DATABASE (required)
# -----------------------------------------------------------------------------
# Fixture and live MUST be different database names (or namespaces).
# Compose (compose.yaml) maps host :54329 → container :5432:
SIGNAL_INGEST_DSN_FIXTURE=postgresql://signal:signal@127.0.0.1:54329/signal_fixture
SIGNAL_INGEST_DSN_LIVE=postgresql://signal:signal@127.0.0.1:54329/signal_live

# If you use Homebrew Postgres on :5432 instead of Docker/Colima, use these:
# SIGNAL_INGEST_DSN_FIXTURE=postgresql://signal:signal@127.0.0.1:5432/signal_fixture
# SIGNAL_INGEST_DSN_LIVE=postgresql://signal:signal@127.0.0.1:5432/signal_live

# Pytest overrides (optional; same idea as above for gate runs):
# SIGNAL_INGEST_TEST_DSN_FIXTURE=postgresql://signal:signal@127.0.0.1:5432/signal_fixture
# SIGNAL_INGEST_TEST_DSN_LIVE=postgresql://signal:signal@127.0.0.1:5432/signal_live

# -----------------------------------------------------------------------------
# 3) LOCAL PATHS (usually leave as-is)
# -----------------------------------------------------------------------------
SIGNAL_INGEST_RAW_ROOT_FIXTURE=var/fixture/raw
SIGNAL_INGEST_RAW_ROOT_LIVE=var/live/raw
SIGNAL_INGEST_EXPORT_ROOT_FIXTURE=var/fixture/exports
SIGNAL_INGEST_EXPORT_ROOT_LIVE=var/live/exports

# -----------------------------------------------------------------------------
# 4) SAFETY DEFAULTS (keep these for offline work)
# -----------------------------------------------------------------------------
# 1 = block non-loopback sockets (use with fixture mode).
# For live B8 set to 0 so public HTTPS works.
SIGNAL_INGEST_NETWORK_GUARD=1

# Hard zero paid spend. Do not raise unless you intentionally allow billing.
SIGNAL_INGEST_PAID_SPEND_CAP=0

# -----------------------------------------------------------------------------
# 5) UNLOCK B8 · free LLM canary (pick at least ONE)
# -----------------------------------------------------------------------------
# Current gate is BLOCKED without a real free/local provider.
# After setting keys, also flip SIGNAL_INGEST_MODE=live and
# SIGNAL_INGEST_NETWORK_GUARD=0, then:
#   signal-ingest --mode live qualify --track canary
#   # then full acquisition → live export → .venv/bin/python tools/gate.py B8
#
# Option A — Google AI Studio free Gemini key
#   https://aistudio.google.com/apikey
# GEMINI_API_KEY=
#
# Option B — Groq free-tier key
#   https://console.groq.com/keys
# GROQ_API_KEY=
#
# Option C — local Ollama (no key). Start the app, pull a model, leave URL default:
#   ollama pull <instruction-model>
# OLLAMA_HOST=http://127.0.0.1:11434
#
# Option D — Meta Model API (dev.meta.ai), billed from your own credits. Used only
#   after the free tiers, under paid_spend_cap in config/providers.yaml.
# MODEL_API_KEY=
#
# Model IDs are selected in config/providers.yaml at B8 (enable the tier there).
# Fake/replay providers never count as live proof.

# -----------------------------------------------------------------------------
# 6) OPTIONAL · higher GitHub rate limit for paper→repo stars (B8 bulk)
# -----------------------------------------------------------------------------
# Anonymous GitHub REST ≈ 60 req/h. Authenticated free user ≈ 5,000 req/h.
# Create a classic PAT with public-repo read only if you hit 403/rate limits:
#   https://github.com/settings/tokens
# GITHUB_TOKEN=
# GH_TOKEN=

# -----------------------------------------------------------------------------
# 7) B9 · Google Sheet (applicant publishes; not required in .env for scaffold)
# -----------------------------------------------------------------------------
# Public view-only Sheet is created/imported by you near submission.
# Put the published URL in the release manifest / README handoff — not here
# unless you later wire Sheets API credentials yourself (out of default path).
# GOOGLE_SHEETS_SPREADSHEET_ID=

# -----------------------------------------------------------------------------
# 7) OPTIONAL · per-site politeness (per worker process)
# -----------------------------------------------------------------------------
# Effective rate to one site = these limits x number of worker processes.
# SIGNAL_INGEST_ORIGIN_CONCURRENCY=2
# SIGNAL_INGEST_ORIGIN_MIN_INTERVAL_S=0.05
